{
  "curlPath": "curl",
  "jqPath": "jq",
  "grepPath": "grep",
  "defaultTimeoutMs": 0,
  "defaultCurlFlags": {
    "includeHeaders": true,
    "followRedirects": false,
    "silentAndShowErrors": true
  },
  "shortcuts": {
    "runRequest": "CtrlOrCmd+Enter",
    "runTemplate": "CtrlOrCmd+Shift+T"
  },
  "globalCurlOptions": [
    {
      "id": "example-routing",
      "label": "Example routing (documentation only)",
      "argsText": "--resolve example.com:443:192.0.2.10"
    }
  ]
}
